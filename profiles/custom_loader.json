{
    "name": "Custom Loader",
    "author": "noop",
    "template": "custom",
    "filename": "loader.cpp",
    "target_process": "svchost.exe",
    "arch": "x64",
    "compile": {
        "automatic": true,
        "compiler": "x86_64-w64-mingw32-g++",
        "strip": true,
        "output_type": "exe",
        "args": [
            "-O2",
            "-fno-exceptions",
            "-fno-rtti",
            "-ffunction-sections",
            "-fdata-sections",
            "-Wl,--gc-sections",
            "-mwindows"
        ],
        "libs": [
            "-lbcrypt",
            "-lws2_32"
        ]
    },
    "output_dir": "./output"
}